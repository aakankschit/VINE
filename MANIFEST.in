include README.md
include LICENSE
include requirements.txt
recursive-include src/vine_fep *.py
recursive-include src/maple_fep *.py
recursive-include docs *.md *.rst *.txt
recursive-include examples *.py
exclude src/vine_fep/**/__pycache__
exclude src/vine_fep/**/*.pyc
exclude **/__pycache__
exclude **/*.pyc
prune tests
prune demo_results
prune test_results
prune test_tutorial_results
prune figures
prune results
prune research
prune manuscript
prune docs/_build
